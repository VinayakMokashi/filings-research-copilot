# Copy to .env and fill in what you need. .env is git-ignored.
# Empty values count as unset.

# --- LLM providers --------------------------------------------------------------
# Groq is the primary provider. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional extra providers. Each key is used by any model id with its prefix (cerebras/ or
# openrouter/) in FRC_LLM_STRONG_MODEL, FRC_LLM_FAST_MODEL, FRC_LLM_SMALL_MODEL or
# FRC_LLM_FALLBACK_MODELS.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Model roles (LiteLLM model ids: <provider>/<model>) --------------------------
# FRC_LLM_STRONG_MODEL=groq/openai/gpt-oss-120b
# FRC_LLM_FAST_MODEL=groq/qwen/qwen3.8-27b
# FRC_LLM_SMALL_MODEL=groq/openai/gpt-oss-20b
# FRC_LLM_FALLBACK_MODELS=cerebras/gpt-oss-120b
# FRC_LLM_TIMEOUT_S=60
# FRC_LLM_MAX_RETRIES=2
# FRC_LLM_TEMPERATURE=0
# Batch jobs (evaluation runs) pause to stay under each model's tokens-a-minute limit.
# FRC_LLM_TOKENS_PER_MINUTE=8000

# --- SEC EDGAR --------------------------------------------------------------------
# SEC asks every client to identify itself, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=

# --- Local services (docker compose) -----------------------------------------------
# FRC_QDRANT_URL=http://127.0.0.1:6333
# FRC_DATABASE_URL=postgresql://copilot:copilot@127.0.0.1:5433/copilot
# POSTGRES_PASSWORD=copilot
# QDRANT_PORT=6333
# POSTGRES_PORT=5433
# The whole stack (poe stack-up) also publishes these
# API_PORT=8000
# UI_PORT=8501
# MCP_PORT=8001

# --- Langfuse: traces of the API's runs ------------------------------------------------
# Tracing is on when both keys are set; create them in a Langfuse project's settings.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# The EU region by default; https://us.cloud.langfuse.com for the US one
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- API ----------------------------------------------------------------------------
# memory (default) or postgres: where the API keeps conversations, notes and feedback
# FRC_API_STATE=memory
# Questions a day before the API answers 429: per visitor, and in total
# FRC_API_DAILY_QUESTIONS=20
# FRC_API_DAILY_TOTAL=200
# Days a stored answer to a repeated question is served again (0 turns the cache off)
# FRC_API_CACHE_DAYS=7
# Where the web UI and the MCP server find the API
# FRC_API_URL=http://127.0.0.1:8000

# --- App ----------------------------------------------------------------------------
# FRC_ENV=dev
# FRC_LOG_LEVEL=INFO
# FRC_LOG_FORMAT=console
