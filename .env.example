# Copy to .env and fill in what you need. .env is git-ignored.
# Empty values count as unset.

# --- LLM providers --------------------------------------------------------------
# Groq is the primary provider. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional extra providers. Each key is used by any model id with its prefix (cerebras/ or
# openrouter/) in FRC_LLM_STRONG_MODEL, FRC_LLM_FAST_MODEL, FRC_LLM_SMALL_MODEL or
# FRC_LLM_FALLBACK_MODELS.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Model roles (LiteLLM model ids: <provider>/<model>) --------------------------
# FRC_LLM_STRONG_MODEL=groq/openai/gpt-oss-120b
# FRC_LLM_FAST_MODEL=groq/qwen/qwen3.8-27b
# FRC_LLM_SMALL_MODEL=groq/openai/gpt-oss-20b
# FRC_LLM_FALLBACK_MODELS=cerebras/gpt-oss-120b
# FRC_LLM_TIMEOUT_S=60
# FRC_LLM_MAX_RETRIES=2
# FRC_LLM_TEMPERATURE=0
# Batch jobs (evaluation runs) pause to stay under each model's tokens-a-minute limit.
# FRC_LLM_TOKENS_PER_MINUTE=8000

# --- SEC EDGAR --------------------------------------------------------------------
# SEC asks every client to identify itself, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=

# --- Local services (docker compose) -----------------------------------------------
# FRC_QDRANT_URL=http://127.0.0.1:6333
# Qdrant Cloud's database key; a local Qdrant needs none
# FRC_QDRANT_API_KEY=
# The collection the doc agent searches; its index card names the model for its queries
# FRC_COLLECTION=fb_page_bge-small
# How the doc agent picks its answer model: fixed, or epsilon-greedy over three settings
# FRC_ANSWER_POLICY=fixed
# FRC_DATABASE_URL=postgresql://copilot:copilot@127.0.0.1:5433/copilot
# Run the data agent's queries on PostgreSQL (the facts_reader role from
# poe load-facts-postgres), with facts.db while the server is down. Set it in a run's
# environment rather than here: with it set, every data question goes to the server.
# FRC_FACTS_URL=postgresql://facts_reader:facts_reader@127.0.0.1:5433/facts?connect_timeout=2
# POSTGRES_PASSWORD=copilot
# QDRANT_PORT=6333
# POSTGRES_PORT=5433
# The whole stack (poe stack-up) also publishes these
# API_PORT=8000
# UI_PORT=8501
# MCP_PORT=8001

# --- Langfuse: traces of the API's runs ------------------------------------------------
# Tracing is on when both keys are set; create them in a Langfuse project's settings.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# The EU region by default; https://us.cloud.langfuse.com for the US one
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Hugging Face: publishing the trained models (poe publish-router) ----------------
# A fine-grained token with write access to your namespace
# HF_TOKEN=

# --- API ----------------------------------------------------------------------------
# memory (default), postgres, or firestore on Google Cloud: where the API keeps feedback,
# quotas and cached answers (and, with postgres, conversations and notes)
# FRC_API_STATE=memory
# Questions a day before the API answers 429: per visitor, and in total
# FRC_API_DAILY_QUESTIONS=20
# FRC_API_DAILY_TOTAL=200
# Days a stored answer to a repeated question is served again (0 turns the cache off)
# FRC_API_CACHE_DAYS=7
# Where the web UI and the MCP server find the API
# FRC_API_URL=http://127.0.0.1:8000
# Sign calls to the API with a Google ID token (the deployment, where the API is private)
# FRC_API_ID_TOKEN=false
# Off in the deployment, whose file system is the instance's memory: the trace file under
# data/traces, and the model calls cached under data/cache
# FRC_API_TRACE_FILE=true
# FRC_LLM_DISK_CACHE=true
# Host names MCP clients may use for the HTTP transport, besides this machine's
# FRC_MCP_ALLOWED_HOSTS=

# --- App ----------------------------------------------------------------------------
# FRC_ENV=dev
# FRC_LOG_LEVEL=INFO
# FRC_LOG_FORMAT=console
