# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets and local configuration
.env
.env.*
!.env.example

# Data and model artifacts: large, reproducible or licensed.
# data/reference/ holds small committed files (manifests, curated mappings); the rest of
# data/ is downloads and built databases.
data/*
!data/reference/
/models/
*.onnx
*.safetensors

# Infrastructure state and variables
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
